#!/bin/zsh
# Music control helper scripts
# Requires: mpv with input-ipc-server running

MPV_SOCKET="/tmp/mpvsocket"

mpc_cmd() {
    [ -S "$MPV_SOCKET" ] && echo "$1" | socat - "$MPV_SOCKET" 2>/dev/null
}

mplay() {
    if [ -z "$1" ]; then
        echo "Usage: mplay <file|folder|url>"
        return 1
    fi
    local target="$1"
    local config="$HOME/.config/mpv/mpv.conf"
    if [ -d "$target" ]; then
        mpv --include="$config" --profile=music -- "$target"/*
    elif [ -f "$target" ]; then
        mpv --include="$config" --profile=music -- "$target"
    else
        mpv --include="$config" --profile=music -- "$target"
    fi
}

mpause() {
    mpc_cmd "cycle pause"
}

mnext() {
    mpc_cmd "playlist-next"
}

mprev() {
    mpc_cmd "playlist-prev"
}

mstop() {
    mpc_cmd "quit"
}

mvol() {
    local level="${1:-100}"
    # Set mpv internal volume
    mpc_cmd "set volume $level"
    # Optionally sync with system volume if 'sys' is passed as 2nd arg
    if [ "$2" = "sys" ]; then
        if command -v termux-volume > /dev/null; then
            termux-volume music "$((level / 6))" # Termux volume is usually 0-15
        fi
    fi
}

mseek() {
    local pos="${1:-0}"
    mpc_cmd "seek $pos"
}

minfo() {
    local output
    output=$(mpc_cmd "get_property media-title" 2>/dev/null)
    if [ -n "$output" ]; then
        echo "$output"
    else
        echo "No track playing"
    fi
}

mqueue() {
    local target="$1"
    if [ -n "$target" ]; then
        echo "loadfile \"$target\" append" | socat - "$MPV_SOCKET" 2>/dev/null
    fi
}